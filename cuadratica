#include <iostream>
#include <cmath>

using namespace std;
int main()
{
    int a, b, c;
    double x1,x2;
    
   cout<<"Registrar a:";
   cin>> a;
   cout<<"Registrar b:";
   cin>> b;
   cout<<"Registrar c:";
   cin>> c;
   
   x1 = (-b+sqrt(b*b-4*a*c))/(2*a);
   x2 = (-b-sqrt(b*b-4*a*c))/(2*a);
 
   cout<<"La primera solucion x1 es:" <<x1<< endl;
   cout<<"La segunda solucion x2 es:" <<x2<< endl;
    return 0;
}
