#include <iostream>
#include <math.h>
using namespace std;

int main()
{
  float x1,y1,x2,y2,x3,y3;
  double d,h,k,r;
  cout<<"Ingresar x1"<<endl;
  cin>>x1;
  cout<<"Ingresar y1"<<endl;
  cin>>y1;
  cout<<"Ingresar x2"<<endl;
  cin>>x2,
  cout<<"Ingresar y2"<<endl;
  cin>>y2;
  cout<<"Ingresar x3"<<endl;
  cin>>x3;
  cout<<"Ingresar y3"<<endl;
  cin>>y3;
  d=2*(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2));
  h=((pow(x1,2)+pow(y1,2))*(y2-y3)+(pow(x2,2)+pow(y2,2))*(y3-y1)+(pow(x3,2)+pow(y3,2))*(y1-y2))/d;
  k=((pow(x1,2)+pow(y1,2))*(x3-x2)+(pow(x2,2)+pow(y2,2))*(x1-x3)+(pow(x3,2)+pow(y3,2))*(x2-x1))/d;
  
  r=sqrt(pow(x1-h,2)+pow(y1-k,2));
  cout<<"El centro es:("<<h<<","<<k<<")"<<endl;
  cout<<"El radio es:"<<r;
    return 0;
}
